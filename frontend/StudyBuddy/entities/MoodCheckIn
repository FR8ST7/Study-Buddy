{
  "name": "MoodCheckIn",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Check-in date"
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "okay",
        "stressed",
        "overwhelmed"
      ],
      "description": "Current mood"
    },
    "stress_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Stress level 1-10"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "ai_suggestion": {
      "type": "string",
      "description": "AI-generated wellness suggestion"
    }
  },
  "required": [
    "date",
    "mood"
  ],
  "rls": {
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}