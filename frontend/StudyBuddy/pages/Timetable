import React, { useState, useEffect } from "react";
import { Timetable } from "@/entities/Timetable";
import { User } from "@/entities/User";
import { Calendar, Clock, Plus, Edit, Trash2, MapPin } from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";

const daysOfWeek = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"];
const dayLabels = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

export default function TimetablePage() {
  const [timetable, setTimetable] = useState([]);
  const [showForm, setShowForm] = useState(false);
  const [editingEntry, setEditingEntry] = useState(null);
  const [formData, setFormData] = useState({
    day_of_week: "monday",
    start_time: "",
    end_time: "",
    subject: "",
    type: "class",
    location: "",
    teacher_name: "",
    color: "#98FB98"
  });

  const colors = ["#98FB98", "#87CEEB", "#DDA0DD", "#FFB6C1", "#F0E68C", "#FFA07A"];

  useEffect(() => {
    loadTimetable();
  }, []);

  const loadTimetable = async () => {
    try {
      const user = await User.me();
      const entries = await Timetable.filter({ created_by: user.email });
      setTimetable(entries);
    } catch (error) {
      console.error("Failed to load timetable:", error);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!formData.start_time || !formData.end_time || !formData.subject) {
      alert("Please fill in all required fields");
      return;
    }

    try {
      if (editingEntry) {
        await Timetable.update(editingEntry.id, formData);
      } else {
        await Timetable.create(formData);
      }
      setShowForm(false);
      setEditingEntry(null);
      setFormData({
        day_of_week: "monday",
        start_time: "",
        end_time: "",
        subject: "",
        type: "class",
        location: "",
        teacher_name: "",
        color: "#98FB98"
      });
      loadTimetable();
    } catch (error) {
      console.error("Failed to save timetable entry:", error);
    }
  };

  const handleEdit = (entry) => {
    setEditingEntry(entry);
    setFormData(entry);
    setShowForm(true);
  };

  const handleDelete = async (id) => {
    if (window.confirm("Delete this entry?")) {
      try {
        await Timetable.delete(id);
        loadTimetable();
      } catch (error) {
        console.error("Failed to delete entry:", error);
      }
    }
  };

  const getTimetableForDay = (day) => {
    return timetable
      .filter(entry => entry.day_of_week === day)
      .sort((a, b) => a.start_time.localeCompare(b.start_time));
  };

  const inputStyle = "w-full p-3 bg-white border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-[#87CEEB] neo-shadow-small";
  const buttonStyle = "py-3 px-6 border-2 border-black rounded-lg neo-shadow hover:neo-shadow-small active:shadow-none transform active:translate-x-[2px] active:translate-y-[2px] transition-all duration-150 font-bold";

  return (
    <div className="space-y-8">
      <div className="text-center">
        <Calendar className="mx-auto h-16 w-16 mb-4" />
        <h1 className="text-4xl font-bold">My Timetable</h1>
        <p className="text-lg text-gray-700 mt-2">
          Organize your classes and schedule
        </p>
      </div>

      <div className="flex justify-end">
        <button
          onClick={() => setShowForm(!showForm)}
          className={`${buttonStyle} bg-[#98FB98] flex items-center gap-2`}
        >
          <Plus className="w-5 h-5" />
          Add Class
        </button>
      </div>

      <AnimatePresence>
        {showForm && (
          <motion.div
            initial={{ opacity: 0, height: 0 }}
            animate={{ opacity: 1, height: "auto" }}
            exit={{ opacity: 0, height: 0 }}
            className="p-6 bg-white border-4 border-black rounded-xl neo-shadow"
          >
            <h3 className="text-2xl font-bold mb-4">
              {editingEntry ? "Edit Entry" : "Add New Entry"}
            </h3>
            <form onSubmit={handleSubmit} className="space-y-4">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="font-bold block mb-1">Day*</label>
                  <select
                    value={formData.day_of_week}
                    onChange={(e) => setFormData({ ...formData, day_of_week: e.target.value })}
                    className={inputStyle}
                  >
                    {daysOfWeek.map((day, idx) => (
                      <option key={day} value={day}>{dayLabels[idx]}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="font-bold block mb-1">Subject*</label>
                  <input
                    type="text"
                    value={formData.subject}
                    onChange={(e) => setFormData({ ...formData, subject: e.target.value })}
                    className={inputStyle}
                    placeholder="e.g., Mathematics"
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label className="font-bold block mb-1">Start Time*</label>
                  <input
                    type="time"
                    value={formData.start_time}
                    onChange={(e) => setFormData({ ...formData, start_time: e.target.value })}
                    className={inputStyle}
                  />
                </div>
                <div>
                  <label className="font-bold block mb-1">End Time*</label>
                  <input
                    type="time"
                    value={formData.end_time}
                    onChange={(e) => setFormData({ ...formData, end_time: e.target.value })}
                    className={inputStyle}
                  />
                </div>
                <div>
                  <label className="font-bold block mb-1">Type</label>
                  <select
                    value={formData.type}
                    onChange={(e) => setFormData({ ...formData, type: e.target.value })}
                    className={inputStyle}
                  >
                    <option value="class">Class</option>
                    <option value="lab">Lab</option>
                    <option value="tutorial">Tutorial</option>
                    <option value="study">Study Time</option>
                    <option value="break">Break</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="font-bold block mb-1">Teacher/Instructor</label>
                  <input
                    type="text"
                    value={formData.teacher_name}
                    onChange={(e) => setFormData({ ...formData, teacher_name: e.target.value })}
                    className={inputStyle}
                    placeholder="Prof. Smith"
                  />
                </div>
                <div>
                  <label className="font-bold block mb-1">Location</label>
                  <input
                    type="text"
                    value={formData.location}
                    onChange={(e) => setFormData({ ...formData, location: e.target.value })}
                    className={inputStyle}
                    placeholder="Room 101 or Meeting Link"
                  />
                </div>
              </div>

              <div>
                <label className="font-bold block mb-1">Color</label>
                <div className="flex gap-2">
                  {colors.map(color => (
                    <button
                      key={color}
                      type="button"
                      onClick={() => setFormData({ ...formData, color })}
                      className={`w-10 h-10 rounded-full border-2 ${
                        formData.color === color ? 'border-black' : 'border-gray-300'
                      }`}
                      style={{ backgroundColor: color }}
                    />
                  ))}
                </div>
              </div>

              <div className="flex gap-3">
                <button
                  type="button"
                  onClick={() => {
                    setShowForm(false);
                    setEditingEntry(null);
                  }}
                  className={`${buttonStyle} bg-gray-300 flex-1`}
                >
                  Cancel
                </button>
                <button type="submit" className={`${buttonStyle} bg-[#98FB98] flex-1`}>
                  {editingEntry ? "Update" : "Add"} Entry
                </button>
              </div>
            </form>
          </motion.div>
        )}
      </AnimatePresence>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {daysOfWeek.map((day, idx) => (
          <motion.div
            key={day}
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: idx * 0.05 }}
            className="p-4 bg-white border-4 border-black rounded-xl neo-shadow"
          >
            <h3 className="text-xl font-bold mb-4">{dayLabels[idx]}</h3>
            <div className="space-y-2">
              {getTimetableForDay(day).length > 0 ? (
                getTimetableForDay(day).map((entry) => (
                  <div
                    key={entry.id}
                    className="p-3 border-2 border-black rounded-lg relative group"
                    style={{ backgroundColor: entry.color }}
                  >
                    <div className="flex justify-between items-start">
                      <div className="flex-1">
                        <h4 className="font-bold">{entry.subject}</h4>
                        <div className="flex items-center gap-2 text-sm mt-1">
                          <Clock className="w-4 h-4" />
                          <span>{entry.start_time} - {entry.end_time}</span>
                        </div>
                        {entry.teacher_name && (
                          <p className="text-sm mt-1">👨‍🏫 {entry.teacher_name}</p>
                        )}
                        {entry.location && (
                          <div className="flex items-center gap-1 text-sm mt-1">
                            <MapPin className="w-4 h-4" />
                            <span>{entry.location}</span>
                          </div>
                        )}
                      </div>
                      <div className="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button
                          onClick={() => handleEdit(entry)}
                          className="p-1 bg-white border border-black rounded hover:bg-gray-100"
                        >
                          <Edit className="w-4 h-4" />
                        </button>
                        <button
                          onClick={() => handleDelete(entry.id)}
                          className="p-1 bg-red-200 border border-black rounded hover:bg-red-300"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    </div>
                  </div>
                ))
              ) : (
                <div className="text-center py-8 text-gray-500">
                  <p className="text-sm">No classes scheduled</p>
                </div>
              )}
            </div>
          </motion.div>
        ))}
      </div>
    </div>
  );
}
