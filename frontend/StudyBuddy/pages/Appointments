import React, { useState, useEffect } from "react";
import { Appointment } from "@/entities/Appointment";
import { User } from "@/entities/User";
import { Calendar, Clock, Plus, CheckCircle, XCircle, Video } from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";
import { format } from "date-fns";

export default function AppointmentsPage() {
  const [appointments, setAppointments] = useState([]);
  const [user, setUser] = useState(null);
  const [showForm, setShowForm] = useState(false);
  const [formData, setFormData] = useState({
    title: "",
    description: "",
    teacher_email: "",
    student_email: "",
    scheduled_date: "",
    duration: 30,
    meeting_link: ""
  });

  useEffect(() => {
    loadUser();
  }, []);

  useEffect(() => {
    if (user) {
      loadAppointments();
    }
  }, [user]);

  const loadUser = async () => {
    try {
      const currentUser = await User.me();
      setUser(currentUser);
    } catch (error) {
      console.error("Failed to load user:", error);
    }
  };

  const loadAppointments = async () => {
    try {
      let userAppointments;
      if (user.account_type === "teacher") {
        userAppointments = await Appointment.filter({ teacher_email: user.email }, "-scheduled_date");
      } else {
        userAppointments = await Appointment.filter({ student_email: user.email }, "-scheduled_date");
      }
      setAppointments(userAppointments);
    } catch (error) {
      console.error("Failed to load appointments:", error);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!formData.title || !formData.scheduled_date) {
      alert("Please fill in required fields");
      return;
    }

    try {
      const appointmentData = {
        ...formData,
        requested_by: user.account_type
      };

      if (user.account_type === "student") {
        appointmentData.student_email = user.email;
        appointmentData.status = "pending";
      } else {
        appointmentData.teacher_email = user.email;
        appointmentData.status = "confirmed";
      }

      await Appointment.create(appointmentData);
      setShowForm(false);
      setFormData({
        title: "",
        description: "",
        teacher_email: "",
        student_email: "",
        scheduled_date: "",
        duration: 30,
        meeting_link: ""
      });
      loadAppointments();
    } catch (error) {
      console.error("Failed to create appointment:", error);
    }
  };

  const updateAppointmentStatus = async (id, status) => {
    try {
      await Appointment.update(id, { status });
      loadAppointments();
    } catch (error) {
      console.error("Failed to update appointment:", error);
    }
  };

  const getStatusColor = (status) => {
    const colors = {
      pending: "bg-yellow-200",
      confirmed: "bg-green-200",
      completed: "bg-blue-200",
      cancelled: "bg-red-200"
    };
    return colors[status] || "bg-gray-200";
  };

  const inputStyle = "w-full p-3 bg-white border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-[#87CEEB] neo-shadow-small";
  const buttonStyle = "py-3 px-6 border-2 border-black rounded-lg neo-shadow hover:neo-shadow-small active:shadow-none transform active:translate-x-[2px] active:translate-y-[2px] transition-all duration-150 font-bold";

  if (!user) {
    return <div className="text-center py-10">Loading...</div>;
  }

  return (
    <div className="space-y-8">
      <div className="text-center">
        <Calendar className="mx-auto h-16 w-16 mb-4" />
        <h1 className="text-4xl font-bold">Appointments</h1>
        <p className="text-lg text-gray-700 mt-2">
          {user.account_type === "teacher" 
            ? "Manage student meetings" 
            : "Book meetings with teachers"}
        </p>
      </div>

      <div className="flex justify-end">
        <button
          onClick={() => setShowForm(!showForm)}
          className={`${buttonStyle} bg-[#98FB98] flex items-center gap-2`}
        >
          <Plus className="w-5 h-5" />
          {user.account_type === "teacher" ? "Schedule Meeting" : "Request Appointment"}
        </button>
      </div>

      <AnimatePresence>
        {showForm && (
          <motion.div
            initial={{ opacity: 0, height: 0 }}
            animate={{ opacity: 1, height: "auto" }}
            exit={{ opacity: 0, height: 0 }}
            className="p-6 bg-white border-4 border-black rounded-xl neo-shadow"
          >
            <h3 className="text-2xl font-bold mb-4">New Appointment</h3>
            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="font-bold block mb-1">Title*</label>
                <input
                  type="text"
                  value={formData.title}
                  onChange={(e) => setFormData({ ...formData, title: e.target.value })}
                  className={inputStyle}
                  placeholder="Discussion about..."
                />
              </div>

              <div>
                <label className="font-bold block mb-1">Description</label>
                <textarea
                  value={formData.description}
                  onChange={(e) => setFormData({ ...formData, description: e.target.value })}
                  className={inputStyle + " h-24"}
                  placeholder="Purpose of meeting..."
                />
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="font-bold block mb-1">
                    {user.account_type === "teacher" ? "Student Email*" : "Teacher Email*"}
                  </label>
                  <input
                    type="email"
                    value={user.account_type === "teacher" ? formData.student_email : formData.teacher_email}
                    onChange={(e) => setFormData({ 
                      ...formData, 
                      [user.account_type === "teacher" ? "student_email" : "teacher_email"]: e.target.value 
                    })}
                    className={inputStyle}
                    placeholder="email@example.com"
                  />
                </div>
                <div>
                  <label className="font-bold block mb-1">Duration (minutes)</label>
                  <select
                    value={formData.duration}
                    onChange={(e) => setFormData({ ...formData, duration: parseInt(e.target.value) })}
                    className={inputStyle}
                  >
                    <option value={15}>15 minutes</option>
                    <option value={30}>30 minutes</option>
                    <option value={45}>45 minutes</option>
                    <option value={60}>1 hour</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="font-bold block mb-1">Date & Time*</label>
                  <input
                    type="datetime-local"
                    value={formData.scheduled_date}
                    onChange={(e) => setFormData({ ...formData, scheduled_date: e.target.value })}
                    className={inputStyle}
                  />
                </div>
                <div>
                  <label className="font-bold block mb-1">Meeting Link (Optional)</label>
                  <input
                    type="url"
                    value={formData.meeting_link}
                    onChange={(e) => setFormData({ ...formData, meeting_link: e.target.value })}
                    className={inputStyle}
                    placeholder="https://meet.google.com/..."
                  />
                </div>
              </div>

              <div className="flex gap-3">
                <button
                  type="button"
                  onClick={() => setShowForm(false)}
                  className={`${buttonStyle} bg-gray-300 flex-1`}
                >
                  Cancel
                </button>
                <button type="submit" className={`${buttonStyle} bg-[#98FB98] flex-1`}>
                  {user.account_type === "teacher" ? "Schedule" : "Request"} Appointment
                </button>
              </div>
            </form>
          </motion.div>
        )}
      </AnimatePresence>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {appointments.map((appt) => (
          <motion.div
            key={appt.id}
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className={`p-5 border-4 border-black rounded-xl neo-shadow ${getStatusColor(appt.status)}`}
          >
            <div className="flex justify-between items-start mb-3">
              <h3 className="text-lg font-bold">{appt.title}</h3>
              <span className="px-2 py-1 text-xs font-bold bg-white border border-black rounded capitalize">
                {appt.status}
              </span>
            </div>

            {appt.description && (
              <p className="text-sm mb-3">{appt.description}</p>
            )}

            <div className="space-y-2 text-sm">
              <div className="flex items-center gap-2">
                <Clock className="w-4 h-4" />
                <span>{format(new Date(appt.scheduled_date), "MMM d, yyyy 'at' h:mm a")}</span>
              </div>
              <div className="flex items-center gap-2">
                <Calendar className="w-4 h-4" />
                <span>{appt.duration} minutes</span>
              </div>
              {appt.meeting_link && (
                <a
                  href={appt.meeting_link}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="flex items-center gap-2 text-blue-600 hover:text-blue-800"
                >
                  <Video className="w-4 h-4" />
                  <span>Join Meeting</span>
                </a>
              )}
            </div>

            {user.account_type === "teacher" && appt.status === "pending" && (
              <div className="flex gap-2 mt-4">
                <button
                  onClick={() => updateAppointmentStatus(appt.id, "confirmed")}
                  className="flex-1 py-2 bg-green-300 border-2 border-black rounded-lg font-bold text-sm hover:bg-green-400 flex items-center justify-center gap-1"
                >
                  <CheckCircle className="w-4 h-4" />
                  Confirm
                </button>
                <button
                  onClick={() => updateAppointmentStatus(appt.id, "cancelled")}
                  className="flex-1 py-2 bg-red-300 border-2 border-black rounded-lg font-bold text-sm hover:bg-red-400 flex items-center justify-center gap-1"
                >
                  <XCircle className="w-4 h-4" />
                  Decline
                </button>
              </div>
            )}

            {appt.status === "confirmed" && (
              <button
                onClick={() => updateAppointmentStatus(appt.id, "completed")}
                className="w-full mt-4 py-2 bg-blue-300 border-2 border-black rounded-lg font-bold text-sm hover:bg-blue-400"
              >
                Mark as Completed
              </button>
            )}
          </motion.div>
        ))}
      </div>

      {appointments.length === 0 && (
        <div className="text-center py-10 px-6 bg-white border-4 border-black rounded-xl neo-shadow">
          <Calendar className="mx-auto h-16 w-16 mb-4 text-gray-300" />
          <h3 className="text-2xl font-bold">No Appointments</h3>
          <p className="mt-2 text-gray-600">
            {user.account_type === "teacher" 
              ? "Schedule meetings with your students" 
              : "Request appointments with your teachers"}
          </p>
        </div>
      )}
    </div>
  );
}